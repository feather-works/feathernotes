[Desktop Entry]
Type=Application
Name=FeatherNotes
GenericName=Bloco de notas
Comment=Bloco de notas e post-its da suíte FeatherWorks
Exec=feathernotes
Icon=feathernotes
Terminal=false
Categories=Utility;TextEditor;
